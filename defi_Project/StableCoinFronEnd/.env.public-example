# This file documents all NEXT_PUBLIC_* environment variables
# These are exposed to the client-side browser

# Wallet Connect
# Get your project ID at: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_project_id

# RPC Providers
# Use Alchemy, Infura, or any Web3 RPC provider
# https://www.alchemy.com/ or https://infura.io/
NEXT_PUBLIC_RPC_MAINNET=https://eth-mainnet.alchemy.com/v2/your-key
NEXT_PUBLIC_RPC_SEPOLIA=https://eth-sepolia.alchemy.com/v2/your-key
NEXT_PUBLIC_RPC_ARBITRUM=https://arb-mainnet.alchemy.com/v2/your-key
NEXT_PUBLIC_RPC_POLYGON=https://polygon-mainnet.alchemy.com/v2/your-key
NEXT_PUBLIC_RPC_OPTIMISM=https://opt-mainnet.alchemy.com/v2/your-key

# Contract Addresses
# Replace with your deployed protocol contracts
NEXT_PUBLIC_PROTOCOL_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_USDC_ADDRESS=0x0000000000000000000000000000000000000000

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
